{
  "expo": {
    "name": "地球 Online",
    "slug": "earth-online",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "earthonline",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "地球 Online uses your location for check-ins and local weather/earthquake achievements while the app is open.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "地球 Online uses the camera to save achievement memory photos on your device only.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sensors",
      "expo-file-system",
      "@react-native-google-signin/google-signin",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "OPENWEATHERMAP_API_KEY": "",
      "GOOGLE_CLIENT_ID": "335492280709-70e7rgnsjp4uj41gaj9sek08jtg5b4hv.apps.googleusercontent.com",
      "PRIVACY_POLICY_URL": "https://skps00.github.io/Earth_Online_v2/privacy-policy.html",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "bd47dc4a-b3f5-4360-b32c-1fa701d18e85"
      }
    },
    "android": {
      "package": "com.skps00.earthonline",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK",
        "android.permission.INTERNET"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.skps00.earthonline",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
